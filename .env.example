# mcp-geospatial configuration.
#
# Every value here is OPTIONAL. The server is fully functional with no
# configuration at all: every provider that can require an API key has a
# keyless default.

# --- toolsets ---------------------------------------------------------------
# default (core+rf, 25 tools) | all | offline | a comma-separated list
# GEO_TOOLSETS=default

# --- caching ----------------------------------------------------------------
# Caching is required by several providers' usage policies, not just an
# optimisation. Disable it only for debugging.
# GEO_CACHE_DIR=~/.cache/mcp-geospatial
# GEO_CACHE=1

# --- identification ---------------------------------------------------------
# Nominatim's usage policy requires a descriptive User-Agent identifying the
# application. Override this if you are running a modified deployment.
# GEO_USER_AGENT=mcp-geospatial/0.1.0 (+https://example.com/contact)

# --- self-hosted providers --------------------------------------------------
# Point at your own instances to avoid the public services' rate limits.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PHOTON_URL=https://photon.komoot.io
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
# OPENTOPODATA_URL=https://api.opentopodata.org

# --- optional API keys ------------------------------------------------------
# Routing. The keyless default is Valhalla; this is an upgrade, not a
# requirement. Free tier: https://openrouteservice.org/dev/#/signup
# OPENROUTESERVICE_API_KEY=

# Cell towers. The keyless default is BeaconDB; OpenCelliD has more coverage.
# Free key: https://opencellid.org/
# OPENCELLID_API_KEY=

# Weather. REQUIRED FOR COMMERCIAL USE -- the free Open-Meteo tier is
# non-commercial. https://open-meteo.com/en/pricing
# OPEN_METEO_API_KEY=

# --- HTTP transport ---------------------------------------------------------
# Only used with --transport http. Binds 127.0.0.1 unless PORT is set.
# PORT=8000
# GEO_LOG_LEVEL=INFO
